# Public/browser Supabase values (required at build time by Vite)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_REF
EXPECTED_SUPABASE_PROJECT_REF=YOUR_PROJECT_REF
VITE_PLATFORM_BRAND_NAME=Inbox OS

# Server-side Supabase values (required at runtime by the Vercel server)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Evolution API (required for WhatsApp/Evolution routes)
EVOLUTION_API_URL=https://YOUR_EVOLUTION_HOST
EVOLUTION_API_KEY=YOUR_EVOLUTION_API_KEY
EVOLUTION_WEBHOOK_TOKEN=YOUR_WEBHOOK_SECRET

# Public canonical URL, e.g. https://your-project.vercel.app
PUBLIC_APP_URL=https://YOUR_PROJECT.vercel.app

# Application/auth settings (server-only)
AUTH_CRYPTO_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_BYTES
PLATFORM_BRAND_NAME=InboxOS
PLATFORM_LEGAL_NAME=Operador responsavel
PLATFORM_SUPPORT_EMAIL=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
SYSTEM_CRON_SECRET=
SYSTEM_CRON_SECRET_PREVIOUS=
# Separate secrets for the protected health and Evolution recovery endpoints.
# Keep these different from each other and from AUTH_CRYPTO_SECRET.
HEALTHCHECK_SECRET=
CRON_SECRET=

# Optional allow-list for the admin integration vault. Leave empty unless the
# workspace explicitly enables custom API probes (comma-separated HTTPS hosts).
INTEGRATION_TEST_ALLOWED_HOSTS=

# Billing separate fork (OFF in core)
ENABLE_BILLING=false
VITE_ENABLE_BILLING=false

# System Control Plane (server-side only)
SYSTEM_ADMIN_BOOTSTRAP_EMAILS=owner@example.com
# base64 encoding of a cryptographically random 32-byte vault key, never share it
INTEGRATION_VAULT_KEY=REPLACE_WITH_BASE64_32_BYTES

# Scheduled recovery; opt in only after staging validation.
ENABLE_EVOLUTION_RECOVERY=false
ENABLE_PRIVACY_RETENTION=false

# Somente Deploy Preview com instância Evolution de teste isolada. Nunca habilite com credenciais reais.
EVOLUTION_ALLOW_PREVIEW_WEBHOOK_WRITE=false

# Optional staging-only Evolution smoke test inputs. Never point these at
# production and never enable autoreplies in a preview.
EVOLUTION_STAGING_WEBHOOK_URL=https://preview.example.vercel.app/api/public/webhooks/evolution
EVOLUTION_STAGING_INSTANCE=
EVOLUTION_STAGING_WEBHOOK_TOKEN=
EVOLUTION_STAGING_SUPABASE_REF=staging_project_ref
EVOLUTION_PRODUCTION_SUPABASE_REF=production_project_ref
STAGING_ISOLATED_DB_CONFIRMED=no
STAGING_VERCEL_PREVIEW_CONFIRMED=no
STAGING_AUTOREPLY_DISABLED_CONFIRMED=no

# QA-only (never required by the application runtime).
# TEST_BASE_URL=https://preview.example.vercel.app
# PRODUCTION_APP_URL=https://app.example.com
# AUDIT_USER_EMAIL=qa@example.com
# AUDIT_WORKSPACE_ID=00000000-0000-0000-0000-000000000000
# AUDIT_ONLY=
