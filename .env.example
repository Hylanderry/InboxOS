# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Auth & Security
AUTH_CRYPTO_SECRET=your-32-character-minimum-secret-key-here

# Cloudflare Turnstile (Optional but recommended for production)
# Get these from https://dash.cloudflare.com/?to=/:account/turnstile
VITE_CLOUDFLARE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
CLOUDFLARE_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Optional: Production Safety Checks
EXPECTED_SUPABASE_PROJECT_REF=your-production-project-ref

# Public brand name (non-secret)
VITE_PLATFORM_BRAND_NAME=Inbox OS
